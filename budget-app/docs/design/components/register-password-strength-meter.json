{
  "componentName": "PasswordStrengthMeter",
  "description": "Four-bar password strength indicator with a color-independent label (word + icon + guidance). Renders only when the password field has content.",
  "platform": "react-native",
  "props": {
    "level": { "type": "number", "required": true, "description": "Strength level 1-4 from getPasswordStrength" },
    "label": { "type": "string", "required": true, "description": "Weak | Fair | Good | Strong" },
    "visible": { "type": "boolean", "required": true, "description": "True only when password.length > 0" }
  },
  "variants": ["weak", "fair", "good", "strong"],
  "states": ["hidden", "visible"],
  "levelColorMap": {
    "1": "colors.error",
    "2": "colors.warning",
    "3": "colors.info",
    "4": "colors.success"
  },
  "tokens": {
    "barHeight": 4,
    "barRadius": "radius.full",
    "barGap": "spacing.sm",
    "emptyBar": "colors.glassStrong",
    "labelType": "typography.caption",
    "labelColor": "matches level color",
    "labelIconStrong": "checkmark-circle",
    "labelIconWeak": "alert-circle"
  },
  "accessibility": {
    "colorIndependent": true,
    "note": "The word (Weak/Fair/Good/Strong) plus an icon always accompany the bar fill, so color is never the sole signal.",
    "srLabel": "Password strength: {label}"
  }
}
